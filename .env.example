# Copy this file to .env.local and fill in real values.

# DeepSeek hosted API key (has credit). Leave empty to run in Fixture mode.
DEEPSEEK_API_KEY=

# The DeepSeek model name to use (read from this variable, never hardcoded).
DEEPSEEK_MODEL=

# Access code required to create experiences (both Live and Fixture mode).
LIVE_AI_ACCESS_CODE=

# Max DeepSeek API calls per day (one generation uses 2-4 calls).
AI_DAILY_CAP=150

# Set true to use recorded fixtures instead of DeepSeek (no AI cost).
# On Vercel: Preview deployments use true, Production uses false.
FIXTURE_MODE=true
