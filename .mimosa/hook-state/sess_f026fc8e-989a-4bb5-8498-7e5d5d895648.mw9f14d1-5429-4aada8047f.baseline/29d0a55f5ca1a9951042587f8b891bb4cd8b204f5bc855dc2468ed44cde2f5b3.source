import type { Metadata } from "next";
import { getServerStatus } from "@/config/app-config";
import "./globals.css";

export const metadata: Metadata = {
  title: "ConceptLab",
  description:
    "Type a concept, get an interactive 3D learning experience. Built for teachers and students.",
};

export default function RootLayout({
  children,
}: Readonly<{
  children: React.ReactNode;
}>) {
  const status = getServerStatus();
  return (
    <html lang="en">
      <body>
        {children}
        {/* Mode badge is rendered on the server so it never depends on client state. */}
        <div
          id="mode-badge"
          className="mode-badge"
          data-mode={status.mode}
          title={
            status.mode === "fixture"
              ? "Fixture mode: sample concepts only, no AI calls"
              : "Live mode: concepts are generated by DeepSeek"
          }
        >
          {status.mode === "fixture" ? "Fixture mode" : "Live mode"}
        </div>
      </body>
    </html>
  );
}
